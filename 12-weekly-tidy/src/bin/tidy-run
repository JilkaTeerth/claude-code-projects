#!/bin/zsh
# Wrapper for the weekly launchd job (com.teerth.tidy). Timestamps, caps the log,
# and makes failure LOUD, same pattern as canvas-sweep-run.
LOG=~/Library/Logs/tidy.log
PY=$HOME/.pyenv/versions/3.12.11/bin/python3
[ -x "$PY" ] || PY=/usr/bin/python3
{
  echo "--- $(date '+%Y-%m-%d %H:%M:%S') ---"
  "$PY" $HOME/bin/tidy 2>&1
  rc=$?
  if [ $rc -ne 0 ]; then
    echo "!!! tidy FAILED rc=$rc"
    /opt/homebrew/bin/terminal-notifier -title "Weekly tidy FAILED" \
      -message "rc=$rc. See ~/Library/Logs/tidy.log" 2>/dev/null
  fi
} >> "$LOG" 2>&1
tail -n 2000 "$LOG" > "$LOG.tmp" 2>/dev/null && mv "$LOG.tmp" "$LOG"
